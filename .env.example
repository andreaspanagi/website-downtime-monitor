# Environment Configuration Template
# Copy this file to .env and update with your values

# Server Configuration
# Port number for the Express server
PORT=3000

# MongoDB Configuration
# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/website-monitor
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/website-monitor
MONGODB_URI=mongodb://localhost:27017/website-monitor

# Monitoring Configuration
# Check interval in minutes (how often to check website uptime)
CHECK_INTERVAL=5

# Websites to Monitor (comma-separated for multiple sites)
# Single website: MONITOR_URLS=https://example.com
# Multiple websites: MONITOR_URLS=https://example.com,https://example2.com,https://example3.com
MONITOR_URLS=https://example.com

# Brevo SMTP Configuration
# Get your credentials from https://app.brevo.com/settings/keys/smtp
GMAIL_SMTP_USER=your-smtp-login@smtp-brevo.com
GMAIL_APP_KEY=your-smtp-api-key

# Email Notification Configuration
# Email address(es) to receive down/up alerts
# Single recipient: ALERT_EMAIL=your-email@example.com
# Multiple recipients: ALERT_EMAIL=email1@example.com,email2@example.com,email3@example.com
ALERT_EMAIL=your-email@example.com

# Node Environment
# Options: development, production, test
NODE_ENV=development

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Website Monitor - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <!-- Load Socket.IO client library -->
  <!-- Primary: Use Socket.IO's own serving method -->
  <script src="/socket.io/socket.io.js"></script>
  <!-- Fallback: CDN version if local fails (checks if io is undefined) -->
  <script>
    if (typeof io === 'undefined') {
      console.warn('Socket.IO failed to load from /socket.io/socket.io.js, trying CDN...');
      // Add CDN script as fallback
      var script = document.createElement('script');
      script.src = 'https://cdn.socket.io/4.5.4/socket.io.min.js';
      document.head.appendChild(script);
    }
  </script>
</head>
<body>
  <div class="container">
    <!-- Page Header -->
    <div class="page-header">
      <h1 class="page-header__title">🔍 Website Monitor Dashboard</h1>
      <p class="page-header__description">Real-time monitoring of <%= websites.length %> website<%= websites.length !== 1 ? 's' : '' %></p>
    </div>
    
    <!-- Summary Statistics -->
    <div class="summary-stats">
      <div class="summary-card">
        <div class="summary-card__label">Total Sites</div>
        <div class="summary-card__number summary-card__number--total" id="total-sites"><%= websites.length %></div>
      </div>
      <div class="summary-card">
        <div class="summary-card__label">Sites Up</div>
        <div class="summary-card__number summary-card__number--up" id="sites-up">
          <%= websites.filter(w => w.currentStatus === 'up').length %>
        </div>
      </div>
      <div class="summary-card">
        <div class="summary-card__label">Sites Down</div>
        <div class="summary-card__number summary-card__number--down" id="sites-down">
          <%= websites.filter(w => w.currentStatus === 'down').length %>
        </div>
      </div>
      <div class="summary-card">
        <div class="summary-card__label">Average Uptime</div>
        <div class="summary-card__number summary-card__number--total" id="avg-uptime">-</div>
      </div>
    </div>
    
    <!-- Connection Status Indicator -->
    <div id="connection-status" class="connection-status connection-status--disconnected">
      <span id="connection-text">Connecting to monitoring server...</span>
    </div>
    
    <!-- Websites Grid -->
    <div class="websites-grid">
      <% websites.forEach(function(website) { %>
        <div class="website-card website-card--<%= website.currentStatus %>" data-website-id="<%= website._id %>">
          <!-- Website Header -->
          <div class="website-header">
            <div class="website-header__url"><%= website.url %></div>
            <span class="status-badge status-badge--<%= website.currentStatus %>">
              <% if (website.currentStatus === 'up') { %>
                🟢 UP
              <% } else if (website.currentStatus === 'down') { %>
                🔴 DOWN
              <% } else { %>
                ⚪ UNKNOWN
              <% } %>
            </span>
          </div>
          
          <!-- Website Stats -->
          <div class="website-stats">
            <div class="stat-item">
              <div class="stat-item__label">Response Time</div>
              <div class="stat-item__value" data-stat="response-time">-</div>
            </div>
            <div class="stat-item">
              <div class="stat-item__label">Status Code</div>
              <div class="stat-item__value" data-stat="status-code">-</div>
            </div>
            <div class="stat-item">
              <div class="stat-item__label">24h Uptime</div>
              <div class="stat-item__value" data-stat="uptime">-</div>
            </div>
            <div class="stat-item">
              <div class="stat-item__label">Total Checks</div>
              <div class="stat-item__value" data-stat="check-count">-</div>
            </div>
          </div>
          
          <!-- Last Checked -->
          <div class="last-checked" data-stat="last-checked">
            Last checked: <%= website.lastChecked ? new Date(website.lastChecked).toLocaleString() : 'Never' %>
          </div>
          
          <!-- Website Actions -->
          <div class="website-actions">
            <button class="btn btn--primary btn--full-width check-website-btn" data-website-id="<%= website._id %>">
              Check Now
            </button>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
  
  <script>
    // Store website IDs for tracking
    const websiteIds = <%- JSON.stringify(websiteIds) %>;
    
    // Track connection mode and state
    let connectionMode = 'socket'; // 'socket' or 'polling'
    let socket = null;
    let pollingTimer = null;
    let socketFailureCount = 0;
    const MAX_SOCKET_FAILURES = 3;
    const POLL_INTERVAL = 10000; // 10 seconds
    let previousStates = new Map();
    
    // Update connection status display
    function updateConnectionStatus(status, mode = connectionMode, message = '') {
      const statusEl = document.getElementById('connection-status');
      const textEl = document.getElementById('connection-text');
      
      if (statusEl) {
        statusEl.className = `connection-status connection-status--${status}`;
        
        switch (status) {
          case 'connected':
            if (mode === 'socket') {
              textEl.textContent = '✓ Connected to monitoring server (Socket.IO)';
            } else {
              textEl.textContent = '✓ Auto-refresh enabled (polling mode, every 10s)';
            }
            break;
          case 'disconnected':
            textEl.textContent = '✗ Disconnected - attempting to reconnect...';
            break;
          case 'error':
            textEl.textContent = `⚠️ Connection error: ${message}`;
            break;
          case 'fallback':
            textEl.textContent = '⚠️ Socket.IO unavailable - using polling fallback';
            break;
          default:
            textEl.textContent = 'Connecting to monitoring server...';
        }
      }
    }
    
    // Update summary statistics
    function updateSummaryStats() {
      const cards = document.querySelectorAll('.website-card');
      let upCount = 0;
      let downCount = 0;
      
      cards.forEach(card => {
        if (card.classList.contains('website-card--up')) upCount++;
        if (card.classList.contains('website-card--down')) downCount++;
      });
      
      document.getElementById('sites-up').textContent = upCount;
      document.getElementById('sites-down').textContent = downCount;
    }
    
    // Load statistics for a specific website
    async function loadWebsiteStats(websiteId, card) {
      try {
        // Fetch records for this website
        const response = await fetch(`/api/records?websiteId=${websiteId}&hours=24&limit=100`);
        const data = await response.json();
        
        if (data.success && data.data.records.length > 0) {
          const records = data.data.records;
          
          // Calculate uptime
          const upCount = records.filter(r => r.status === 'up').length;
          const uptimePercent = Math.round((upCount / records.length) * 100);
          
          const uptimeEl = card.querySelector('[data-stat="uptime"]');
          if (uptimeEl) {
            uptimeEl.textContent = uptimePercent + '%';
          }
          
          const checkCountEl = card.querySelector('[data-stat="check-count"]');
          if (checkCountEl) {
            checkCountEl.textContent = records.length;
          }
        }
      } catch (error) {
        console.error('Error loading stats for website:', websiteId, error);
      }
    }
    
    // Update a single website card with latest data (for polling mode)
    async function updateWebsiteCard(websiteId) {
      try {
        const card = document.querySelector(`[data-website-id="${websiteId}"]`);
        if (!card) return;
        
        // Fetch latest website data
        const response = await fetch(`/api/websites/${websiteId}`);
        const data = await response.json();
        
        if (!data.success || !data.data) return;
        
        const website = data.data;
        const currentStatus = website.currentStatus;
        
        // Check if status changed (for notifications in polling mode)
        const previousStatus = previousStates.get(websiteId);
        if (previousStatus && previousStatus !== currentStatus) {
          showNotification({
            website: website.url,
            previousStatus: previousStatus,
            newStatus: currentStatus,
            event: currentStatus === 'down' ? 'DOWN' : 'RECOVERED'
          });
        }
        
        // Store current status
        previousStates.set(websiteId, currentStatus);
        
        // Update status badge
        const statusBadge = card.querySelector('.status-badge');
        if (statusBadge) {
          statusBadge.className = `status-badge status-badge--${currentStatus}`;
          statusBadge.innerHTML = currentStatus === 'up' ? '🟢 UP' : 
                                 currentStatus === 'down' ? '🔴 DOWN' : '⚪ UNKNOWN';
        }
        
        // Update card border
        card.className = `website-card website-card--${currentStatus}`;
        
        // Update stats
        const responseTime = card.querySelector('[data-stat="response-time"]');
        if (responseTime && website.lastResponseTime) {
          responseTime.textContent = website.lastResponseTime + 'ms';
        }
        
        const statusCode = card.querySelector('[data-stat="status-code"]');
        if (statusCode && website.lastStatusCode) {
          statusCode.textContent = website.lastStatusCode;
        }
        
        const lastChecked = card.querySelector('[data-stat="last-checked"]');
        if (lastChecked && website.lastChecked) {
          lastChecked.textContent = 'Last checked: ' + new Date(website.lastChecked).toLocaleString();
        }
        
        // Update summary stats
        updateSummaryStats();
        
        // Load detailed stats
        await loadWebsiteStats(websiteId, card);
        
      } catch (error) {
        console.error('Error updating website card:', websiteId, error);
      }
    }
    
    // Poll all websites for updates (fallback mode)
    async function pollWebsites() {
      console.log('📡 Polling websites for updates (fallback mode)...');
      
      for (const websiteId of websiteIds) {
        await updateWebsiteCard(websiteId);
      }
    }
    
    // Start polling fallback
    function startPolling() {
      if (pollingTimer) return; // Already polling
      
      console.log('▶️ Starting polling fallback...');
      connectionMode = 'polling';
      updateConnectionStatus('connected', 'polling');
      
      // Initial poll
      pollWebsites();
      
      // Set up recurring polling
      pollingTimer = setInterval(pollWebsites, POLL_INTERVAL);
    }
    
    // Stop polling fallback
    function stopPolling() {
      if (pollingTimer) {
        console.log('⏸️ Stopping polling fallback...');
        clearInterval(pollingTimer);
        pollingTimer = null;
      }
    }
    
    // Switch to polling fallback mode
    function switchToPollingFallback() {
      console.warn('⚠️ Switching to polling fallback mode');
      updateConnectionStatus('fallback');
      
      // Disconnect socket if connected
      if (socket) {
        socket.disconnect();
        socket = null;
      }
      
      // Start polling
      startPolling();
    }
    
    // Initialize Socket.IO with error handling and fallback
    function initSocket() {
      // Wait for socket.io library to load
      if (typeof io === 'undefined') {
        console.error('Socket.IO library failed to load. Switching to polling fallback...');
        socketFailureCount = MAX_SOCKET_FAILURES;
        switchToPollingFallback();
        return;
      }
      
      try {
        // Connect to Socket.io with custom options for Hostinger
        socket = io({
          reconnection: true,
          reconnectionDelay: 1000,
          reconnectionDelayMax: 5000,
          reconnectionAttempts: MAX_SOCKET_FAILURES,
          path: '/socket.io',
          transports: ['polling'],  // Polling ONLY
          upgrade: false,           // Disable WebSocket upgrade
          timeout: 10000            // 10 second timeout
        });
        
        // Socket connection handlers
        socket.on('connect', () => {
          console.log('✓ Connected to monitoring server via Socket.IO');
          socketFailureCount = 0; // Reset failure count
          connectionMode = 'socket';
          updateConnectionStatus('connected', 'socket');
          
          // Stop polling if it was running
          stopPolling();
        });
        
        socket.on('connect_error', (error) => {
          console.error('Socket.IO connection error:', error.message);
          socketFailureCount++;
          
          if (socketFailureCount >= MAX_SOCKET_FAILURES) {
            console.error(`❌ Socket.IO failed ${MAX_SOCKET_FAILURES} times. Switching to polling fallback.`);
            switchToPollingFallback();
          } else {
            updateConnectionStatus('error', 'socket', error.message);
          }
        });
        
        socket.on('disconnect', (reason) => {
          console.log('✗ Disconnected from monitoring server:', reason);
          updateConnectionStatus('disconnected');
          
          // If disconnect was not intentional, consider fallback
          if (reason === 'io server disconnect' || reason === 'transport close') {
            socketFailureCount++;
            if (socketFailureCount >= MAX_SOCKET_FAILURES) {
              switchToPollingFallback();
            }
          }
        });
        
        socket.on('reconnect_failed', () => {
          console.error('❌ Socket.IO reconnection failed. Switching to polling fallback.');
          switchToPollingFallback();
        });
        
        // Handle check completed event
        socket.on('checkCompleted', (data) => {
          console.log('✓ Check completed (Socket.IO):', data);
          
          const websiteId = data.website.id;
          const card = document.querySelector(`[data-website-id="${websiteId}"]`);
          
          if (card) {
            // Update status badge
            const statusBadge = card.querySelector('.status-badge');
            if (statusBadge) {
              const status = data.checkResult.status;
              statusBadge.className = `status-badge status-badge--${status}`;
              statusBadge.innerHTML = status === 'up' ? '🟢 UP' : '🔴 DOWN';
            }
            
            // Update card border
            card.className = `website-card website-card--${data.checkResult.status}`;
            
            // Update stats
            const responseTime = card.querySelector('[data-stat="response-time"]');
            if (responseTime) {
              responseTime.textContent = data.checkResult.responseTime + 'ms';
            }
            
            const statusCode = card.querySelector('[data-stat="status-code"]');
            if (statusCode) {
              statusCode.textContent = data.checkResult.statusCode || 'N/A';
            }
            
            const lastChecked = card.querySelector('[data-stat="last-checked"]');
            if (lastChecked) {
              lastChecked.textContent = 'Last checked: ' + new Date(data.checkResult.timestamp).toLocaleString();
            }
            
            // Update summary stats
            updateSummaryStats();
            
            // Load stats for this website
            loadWebsiteStats(websiteId, card);
          }
        });
        
        // Handle alert triggered event
        socket.on('alertTriggered', (data) => {
          console.log('🚨 Alert triggered (Socket.IO):', data);
          showNotification(data);
          updateSummaryStats();
        });
        
      } catch (error) {
        console.error('Failed to initialize Socket.IO:', error);
        switchToPollingFallback();
      }
    }
    
    // Show notification
    function showNotification(alert) {
      const notification = document.createElement('div');
      notification.className = `notification notification--${alert.event.toLowerCase()} notification--slide-in`;
      
      notification.innerHTML = `
        <strong>${alert.event}!</strong><br>
        ${alert.website} is now ${alert.newStatus}
      `;
      
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.classList.remove('notification--slide-in');
        notification.classList.add('notification--slide-out');
        setTimeout(() => notification.remove(), 300);
      }, 5000);
    }
    
    // Setup button listeners
    document.addEventListener('DOMContentLoaded', () => {
      console.log('Dashboard loaded');
      
      // Try Socket.IO first
      initSocket();
      
      // Load stats for all websites
      websiteIds.forEach(websiteId => {
        const card = document.querySelector(`[data-website-id="${websiteId}"]`);
        if (card) {
          loadWebsiteStats(websiteId, card);
        }
      });
      
      // Setup check buttons
      document.querySelectorAll('.check-website-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
          const websiteId = this.dataset.websiteId;
          
          this.disabled = true;
          this.textContent = 'Checking...';
          
          try {
            const response = await fetch('/api/manualCheck', { 
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ websiteId: websiteId })
            });
            
            const data = await response.json();
            
            if (data.success) {
              console.log('✓ Manual check triggered for', websiteId);
              
              // In polling mode, wait a moment then refresh the card
              if (connectionMode === 'polling') {
                setTimeout(() => {
                  updateWebsiteCard(websiteId);
                }, 1000);
              }
              // In socket mode, the update will come via Socket.IO event
            }
          } catch (error) {
            console.error('Error:', error);
          } finally {
            this.disabled = false;
            this.textContent = 'Check Now';
          }
        });
      });
      
      // Handle page visibility changes
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          // Only stop polling if in polling mode
          if (connectionMode === 'polling') {
            stopPolling();
          }
        } else {
          // Resume polling if in polling mode
          if (connectionMode === 'polling') {
            startPolling();
          }
        }
      });
    });
    
    // Clean up on page unload
    window.addEventListener('beforeunload', () => {
      if (socket) {
        socket.disconnect();
      }
      stopPolling();
    });
  </script>
</body>
</html>
